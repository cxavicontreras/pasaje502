# Copiá este archivo a .env y poné tu propia contraseña. .env no se versiona.
DB_NAME=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=cambiame
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/marketplace

# Orígenes del frontend permitidos por CORS, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# "dev" carga los 16 productos ficticios. No lo uses en producción.
SPRING_PROFILES_ACTIVE=dev
PORT=8080
