# Copiá este archivo como .env.local y ajustá los valores. Después reiniciá `npm run dev`.

# Origen de datos: demo = datos ficticios de src/data/demo.ts | api = backend real.
VITE_DATA_MODE=api

# Solo modo api. Origen del backend, sin la ruta /api (el frontend pide {origen}/api/products, etc.).
# Vacío = mismo origen que el frontend.
VITE_API_BASE_URL=

# Solo modo api, opcional y solo para `npm run dev` / `npm run preview`:
# reenvía /api a este backend para no depender de CORS. Se usa dejando VITE_API_BASE_URL vacío.
API_PROXY_TARGET=http://localhost:8080
